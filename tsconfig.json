{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"],
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "packages/**/*.ts",
    "adapters/**/*.ts",
    "tests/support/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
