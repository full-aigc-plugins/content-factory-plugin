{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://partme.ai/schemas/content-factory/author-profile.schema.json",
  "title": "AuthorProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profileId",
    "revision",
    "style",
    "protectedTerms",
    "blockedPhrases",
    "sourceSampleCount",
    "fingerprint"
  ],
  "properties": {
    "profileId": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tone", "sentenceRhythm", "averageSentenceLength"],
      "properties": {
        "tone": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "sentenceRhythm": {
          "enum": ["short", "balanced", "long"]
        },
        "averageSentenceLength": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "protectedTerms": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "blockedPhrases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "sourceSampleCount": { "type": "integer", "minimum": 0 },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
