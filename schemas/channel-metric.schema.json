{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-factory.local/schemas/channel-metric.schema.json",
  "title": "Attributed channel metric",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metricId",
    "channelId",
    "name",
    "definition",
    "numerator",
    "denominator",
    "windowStart",
    "windowEnd",
    "value",
    "status",
    "observedAt",
    "sourceRef"
  ],
  "properties": {
    "metricId": { "type": "string", "minLength": 1 },
    "channelId": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "definition": { "type": "string", "minLength": 1 },
    "numerator": { "type": "number", "minimum": 0 },
    "denominator": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "windowStart": { "type": "string", "format": "date-time" },
    "windowEnd": { "type": "string", "format": "date-time" },
    "value": { "type": ["number", "null"], "minimum": 0 },
    "status": { "enum": ["observed", "not_evaluable"] },
    "observedAt": { "type": "string", "format": "date-time" },
    "sourceRef": { "type": "string", "minLength": 1 }
  }
}
