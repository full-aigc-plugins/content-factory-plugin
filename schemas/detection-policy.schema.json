{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/full-aigc-plugins/content-factory-plugin/schemas/detection-policy.schema.json",
  "title": "DetectionPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mode"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "mode": {
      "enum": ["review", "threshold"],
      "default": "review"
    },
    "maxAiRatio": { "type": "number", "minimum": 0, "maximum": 1 },
    "maxSuspectedRatio": { "type": "number", "minimum": 0, "maximum": 1 },
    "minConfidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "mode": { "const": "threshold" } },
        "required": ["mode"]
      },
      "then": {
        "required": ["maxAiRatio", "maxSuspectedRatio", "minConfidence"]
      }
    }
  ]
}
