{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "content-factory",
  "version": "1.0.0-rc.3",
  "description": "16 个渠道的受控内容生产：选题、写作、编辑、排版、审阅与导出，保留渠道规范。",
  "author": {
    "name": "Full AIGC Plugins"
  },
  "homepage": "https://github.com/full-aigc-plugins/content-factory-plugin",
  "repository": "https://github.com/full-aigc-plugins/content-factory-plugin",
  "license": "Apache-2.0",
  "keywords": [
    "content",
    "editorial",
    "workflow",
    "codex"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Content Factory · Multi-channel Content",
        "shortDescription": "Topic, writing, editing, layout and publishing for 16 channels",
        "longDescription": "Research, draft, edit, format, review, and export evidence-bound content while preserving facts, approvals, revisions, and external-action boundaries.",
        "developerName": "Full AIGC Plugins",
        "category": "Creativity",
        "capabilities": [
          "Interactive",
          "Read",
          "Write"
        ],
        "websiteURL": "https://github.com/full-aigc-plugins/content-factory-plugin",
        "defaultPrompt": [
          "Create an evidence-bound article from supplied materials",
          "Edit and format content without changing protected facts",
          "Prepare a reviewed package for a selected channel"
        ],
        "logo": "./assets/content-factory.svg",
        "logoDark": "./assets/content-factory.svg",
        "composerIcon": "./assets/content-factory.svg",
        "composerIconDark": "./assets/content-factory.svg"
      }
    },
    "ai.nanoco.nanoclaw": {
      "agentName": "Content Factory"
    },
    "ai.partme.localization": {
      "displayName": "Content（多平台内容生产）",
      "displayName_i18n": {
        "zh-CN": "Content（多平台内容生产）"
      },
      "description_i18n": {
        "zh-CN": "16 个渠道的受控内容生产：选题、写作、编辑、排版、审阅与导出，保留渠道规范。"
      }
    }
  }
}
