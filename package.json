{
  "name": "@full-aigc-plugins/content-factory-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node scripts/build.mjs && node --test --test-concurrency=1",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "audit:release": "node scripts/audit-release.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "doctor": "node packages/cli/src/main.ts doctor --json",
    "mcp": "node packages/mcp/src/server.ts",
    "skills:check": "node scripts/check-skills.mjs --offline",
    "skills:check:upstream": "node scripts/check-skills.mjs",
    "skills:sync": "node scripts/sync-skills.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "pdfjs-dist": "6.3.289"
  }
}
